# Copy to .env for local development. utils loads .env on startup when it exists.
ENV=local
SERVICE_NAME=essl_integration_service
SERVER_PORT=8001
SERVICE_BASE_PATH=
LOG_LEVEL=debug

DB_USER=najah_local
DB_PASSWORD=najah_local
DB_HOST=localhost
DB_PORT=55432
DB_NAME=najah_local
DB_SSL_MODE=disable
DB_SSL_CERT_PATH=

# Integration tests run against this database and TRUNCATE it; never point it at real data.
TEST_DB_NAME=najah_test

# Origin of the najah_portal dev server; CORS echoes it so session cookies work.
WEB_ORIGIN=http://localhost:5173

# Signs portal session cookies; at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=

# Session cookie Secure flag. false only for local http development.
COOKIE_SECURE=false

# Include internal error text in API responses. Never true outside local development.
EXPOSE_ERROR_DETAILS=true

# x-api-key for the /internal route group. Generate with: openssl rand -hex 32
API_KEY=

# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For. Empty locally.
TRUSTED_PROXIES=

# Keep every empty device poll in device_raw_messages (protocol debugging only).
ADMS_LOG_HEARTBEATS=false

# Datadog tracer: off unless an agent is running.
DD_TRACE_ENABLED=false
