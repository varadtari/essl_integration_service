# Copy to deploy/.env on the server (never commit it). Generate secrets with: openssl rand -hex 32

ENV=production
APP_DOMAIN=app.example.in
ADMS_DOMAIN=adms.example.in
ADMS_HTTP_PORT=8081
ACME_EMAIL=ops@example.in

DB_USER=najah
DB_PASSWORD=
DB_NAME=najah

JWT_SECRET=
API_KEY=

LOG_LEVEL=info
ADMS_LOG_HEARTBEATS=false

# Images: local builds by default; CI sets these to ghcr.io/... tags.
API_IMAGE=essl_integration_service:local
MIGRATE_IMAGE=essl_integration_service-migrate:local
PORTAL_IMAGE=najah_portal:local
